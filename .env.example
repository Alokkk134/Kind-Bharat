# Copy this file to `.env.local` (for your computer) and add the same values in
# Vercel → Project → Settings → Environment Variables (for the live site).
# `.env.local` is git-ignored. Never commit real keys.

# Public site URL, no trailing slash. Local: http://localhost:3000 · Live: https://kindbharat.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (starts with sb_publishable_). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# "Secret" key (starts with sb_secret_). SERVER ONLY — needed to record guest donations.
# Never prefix with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Any long random text. Used to hash donor IP addresses for spam limits (never stored raw).
RATE_LIMIT_SALT=change-me-to-a-long-random-string
